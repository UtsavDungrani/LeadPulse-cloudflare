{
  "name": "leadpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "deploy:gateway": "wrangler deploy -c gateway/wrangler.jsonc",
    "gateway:status": "node scripts/gateway_status.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:intents": "vitest run src/evals",
    "eval:langfuse": "node scripts/eval_langfuse.mjs",
    "eval:langsmith": "node scripts/eval_langsmith.mjs",
    "eval:ragas": "python scripts/eval_ragas.py",
    "eval:ragas:cheap": "python scripts/eval_ragas.py --judge-model @cf/meta/llama-3.1-8b-instruct",
    "eval:ragas:resume": "python scripts/eval_ragas.py --reuse-runs",
    "eval:ragas:quick": "python scripts/eval_ragas.py --limit 5 --metrics faithfulness,answer_relevancy,factual_correctness",
    "eval:ragas:setup": "pip install -r scripts/requirements-eval.txt",
    "eval:ragas:generate": "python scripts/generate_synthetic_cases.py",
    "import:data": "node scripts/import_data.mjs ./data/foundry",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "eval:ragas:plan": "python scripts/eval_ragas.py --dry-run",
    "eval:ragas:probe": "python scripts/eval_ragas.py --probe-judge",
    "eval:ragas:ollama": "python scripts/eval_ragas.py --judge-base-url http://127.0.0.1:11434 --judge-model qwen2.5:32b",
    "eval:ragas:core": "python scripts/eval_ragas.py --metrics core --reuse-runs --concurrency 1",
    "report:ragas": "python scripts/generate_ragas_eval_report.py"
  },
  "dependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "agents": "^0.24.0",
    "langfuse": "^3.39.2",
    "langsmith": "^0.11.8",
    "mongodb": "^7.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@langfuse/client": "^6.1.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
