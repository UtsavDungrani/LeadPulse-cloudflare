{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadpulse",
  "account_id": "383f4d764d24ff66d8afce4af54b2a62",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      { "name": "AnalystAgent", "class_name": "AnalystAgent" },
      { "name": "WatchtowerAgent", "class_name": "WatchtowerAgent" },
      { "name": "ReportAgent", "class_name": "ReportAgent" },
      { "name": "LeadDeskAgent", "class_name": "LeadDeskAgent" },
      { "name": "SessionsAgent", "class_name": "SessionsAgent" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalystAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["WatchtowerAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["ReportAgent", "LeadDeskAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["SessionsAgent"] }
  ],

  // Workers AI binding - kept as the fallback intent generator.
  "ai": { "binding": "AI" },

  // The built React app, served from the same origin as the API - so there is
  // no proxy and no CORS in production. Assets are matched before the Worker,
  // which then handles /api/*.
  //
  // No `not_found_handling`: the UI routes on the hash (`/#watch`), so `/` is
  // the only HTML path there is. An SPA fallback would be dead config here
  // anyway - the Worker answers every path assets do not, so it is reached
  // first.
  "assets": { "directory": "./dist" },

  "vars": {
    "MONGODB_DB_NAME": "leadpulse",
    // How the Worker reaches Mongo. See HANDOFF.md "The data path problem".
    //   "driver" - mongodb driver inside the Worker over nodejs_compat. This is
    //              what runs: the Phase 1 spike passed against local Mongo and
    //              the integration suite exercises it. The client must live in
    //              a Durable Object, not a module-level cache - see db/driver.ts.
    //   "bridge" - HTTP to a Node service holding the driver. Never built; kept
    //              as the documented fallback if Atlas TLS misbehaves in prod.
    "DATA_PATH_MODE": "driver",
    "BRIDGE_URL": "http://127.0.0.1:8787",
    "LLM_PROVIDER": "workers-ai",
    // When the Watchtower sweeps. Daily, because the detection windows are
    // measured in days - scanning hourly re-tests the same data and spends the
    // multiple-comparison budget for nothing.
    "WATCH_CRON": "0 7 * * *",
    // Weekly digest, Monday morning.
    "REPORT_CRON": "0 8 * * 1",
    // Delivery is OFF by default. "webhook" also needs the REPORT_WEBHOOK_URL
    // secret, and a decision about who may receive lead volumes, rep names and
    // spend figures.
    "REPORT_SINK": "none",
    "LANGFUSE_BASE_URL": "https://cloud.langfuse.com"
  },

  // Secrets (never commit - use .dev.vars locally, `wrangler secret put` remotely):
  //   MONGODB_URI
  //   REPORT_WEBHOOK_URL  (only when REPORT_SINK is "webhook")
  //   LANGFUSE_SECRET_KEY
  //   LANGFUSE_PUBLIC_KEY
}
